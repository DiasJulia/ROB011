<?xml version="1.0"?>
<package format="2">
  <name>tiago_remote</name>
  <version>0.5.0</version>
  <description>Phone web remote for TIAGo: drive with a joystick and control the signvoice ASL translator.</description>
  <maintainer email="leticiaresende.estudo@gmail.com">Leticia</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-tornado</exec_depend>
</package>
