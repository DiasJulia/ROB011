<?xml version="1.0"?>
<!-- Simple dummy person (~1.75 m) for testing the web remote in Gazebo.
     Static: move it with the "translate" tool in the Gazebo window. Faces +X. -->
<sdf version="1.6">
  <model name="person">
    <static>true</static>
    <link name="body">
      <!-- legs -->
      <visual name="leg_l"><pose>0 0.09 0.42 0 0 0</pose><geometry><box><size>0.14 0.13 0.84</size></box></geometry>
        <material><ambient>0.15 0.18 0.3 1</ambient><diffuse>0.15 0.18 0.3 1</diffuse></material></visual>
      <visual name="leg_r"><pose>0 -0.09 0.42 0 0 0</pose><geometry><box><size>0.14 0.13 0.84</size></box></geometry>
        <material><ambient>0.15 0.18 0.3 1</ambient><diffuse>0.15 0.18 0.3 1</diffuse></material></visual>
      <!-- torso -->
      <visual name="torso"><pose>0 0 1.12 0 0 0</pose><geometry><box><size>0.22 0.42 0.56</size></box></geometry>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
      <!-- arms -->
      <visual name="arm_l"><pose>0 0.27 1.1 0 0 0</pose><geometry><box><size>0.1 0.1 0.56</size></box></geometry>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
      <visual name="arm_r"><pose>0 -0.27 1.1 0 0 0</pose><geometry><box><size>0.1 0.1 0.56</size></box></geometry>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
      <!-- head -->
      <visual name="head"><pose>0 0 1.62 0 0 0</pose><geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material><ambient>0.87 0.7 0.58 1</ambient><diffuse>0.87 0.7 0.58 1</diffuse></material></visual>
      <visual name="eye_l"><pose>0.1 0.04 1.65 0 0 0</pose><geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="eye_r"><pose>0.1 -0.04 1.65 0 0 0</pose><geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <!-- collision so the laser sees the legs/body -->
      <collision name="col"><pose>0 0 0.85 0 0 0</pose><geometry><box><size>0.25 0.45 1.7</size></box></geometry></collision>
    </link>
  </model>
</sdf>
