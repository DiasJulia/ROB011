<launch>
  <!-- Web remote: http://localhost:<port>/ on the PC, http://<PC-IP>:<port>/ on the phone.
       Translator: run signvoice.py with the server option, URL ws://localhost:<port>/ws/translator -->
  <arg name="port"          default="8080"/>
  <arg name="cmd_vel_topic" default="/phone_vel"/>  <!-- twist_mux input reserved for phones (priority 98) -->
  <arg name="max_linear"    default="1.0"/>          <!-- m/s (TIAGo base limit: 1.0 forward, 0.2 backward) -->
  <arg name="max_angular"   default="1.5"/>          <!-- rad/s -->

  <node pkg="tiago_remote" type="remote_server.py" name="tiago_remote" output="screen">
    <param name="port"          value="$(arg port)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="max_linear"    value="$(arg max_linear)"/>
    <param name="max_angular"   value="$(arg max_angular)"/>
  </node>
</launch>
